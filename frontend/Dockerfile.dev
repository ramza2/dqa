# syntax=docker/dockerfile:1
#
# DEV-ONLY Vite frontend image for LAN/integration testing via
# docker-compose.onprem.dev.yml.
#
# NEVER use this image for production.
# Production builds must continue to use ./frontend/Dockerfile (nginx SPA)
# and must never inject VITE_DQA_DEV_* identity values.

FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html ./
COPY tsconfig.json tsconfig.app.json tsconfig.node.json ./
COPY vite.config.ts eslint.config.js ./
COPY src ./src

EXPOSE 80

# Bind on 0.0.0.0:80 so the existing Compose publish
#   ${DQA_LAN_BIND_IP}:${DQA_FRONTEND_PORT}:80
# continues to work (e.g. http://192.168.10.104:18080).
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "80"]
