# DQA application
APP_ENV=development
APP_NAME=DEMIS Query Assistant
LOG_LEVEL=INFO

# DQA PostgreSQL
DQA_DB_HOST=localhost
DQA_DB_PORT=5432
DQA_DB_NAME=dqa
DQA_DB_USER=dqa
DQA_DB_PASSWORD=change-me

# LLM provider (OpenAI-compatible abstraction)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# DEMIS read-only target
# Do not commit real production values.
DEMIS_DB_TYPE=oracle
DEMIS_DB_HOST=
DEMIS_DB_PORT=1521
DEMIS_DB_SERVICE=
DEMIS_DB_USER=
DEMIS_DB_PASSWORD=

# Runtime safety defaults
QUERY_DEFAULT_TIMEOUT_SECONDS=30
QUERY_MAX_TIMEOUT_SECONDS=120
QUERY_DEFAULT_ROW_LIMIT=200
QUERY_MAX_ROW_LIMIT=1000
