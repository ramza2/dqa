# DQA application
APP_ENV=development
APP_NAME=DEMIS Query Assistant
LOG_LEVEL=INFO

# Internal/LAN Docker binding
# Keep 127.0.0.1 for host-only development.
# Set DQA_LAN_BIND_IP to the GPU server's internal IPv4 for LAN testing.
DQA_LAN_BIND_IP=127.0.0.1
DQA_BACKEND_PORT=8000
DQA_DB_BIND_IP=127.0.0.1
DQA_DB_EXTERNAL_PORT=5432
# On-prem production Compose uses DQA_FRONTEND_PORT (see .env.onprem.example).
# DQA_FRONTEND_PORT=8080

# DQA PostgreSQL
DQA_DB_HOST=localhost
DQA_DB_PORT=5432
DQA_DB_NAME=dqa
DQA_DB_USER=dqa
DQA_DB_PASSWORD=change-me

# LLM provider (OpenAI-compatible abstraction)
# Optional: core Catalog/Template APIs start without these values.
# Do not commit real endpoints, API keys, or production model names.
# Used only by backend adapters; no public arbitrary chat proxy.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=10
# Optional vLLM/Qwen chat-template control.
# Leave unset for generic OpenAI-compatible providers.
# LLM_ENABLE_THINKING=false

# Parameter extraction may send raw natural-language request text to the LLM.
# Keep false until provider/network/data-egress policy is explicitly approved.
# This setting is a technical opt-in gate only; it is not production approval.
# LLM_PARAMETER_EXTRACTION_ALLOW_RAW_REQUEST=false

# Authentication provider.
# Default disabled = fail-closed on protected endpoints.
# dev_headers is for local development/test only.
# Never enable dev_headers in production.
DQA_AUTH_PROVIDER=disabled

# Frontend local development (Vite only).
# When DQA_AUTH_PROVIDER=dev_headers on the backend, the Vite app may send
# these headers — and ONLY while import.meta.env.DEV is true.
# Production builds never attach X-DQA-Dev-* headers even if these exist.
# VITE_DQA_DEV_ACTOR=query-operator
# VITE_DQA_DEV_ROLES=query_operator

# DEMIS Connection Profile credentials (env: scheme only).
# Only environment variables starting with this dedicated prefix may be resolved.
# Example allowed refs: env:DEMIS_SECRET_PASSWORD, env:DEMIS_SECRET_ORACLE_PASSWORD
# Do not commit real secret values.
DQA_DEMIS_CREDENTIAL_ENV_PREFIX=DEMIS_SECRET_

# DEMIS read-only target metadata (development fallback only; non-secret).
# Production should use an operator-managed Connection Profile.
# Do not assume the real DEMIS DBMS until the integration requirement is confirmed.
DEMIS_DB_TYPE=
DEMIS_DB_HOST=
DEMIS_DB_PORT=
DEMIS_DB_SERVICE=
DEMIS_DB_USER=

# Query execution limits are NOT configured via QUERY_* env vars (unused).
# Authoritative behavior: approved Query Template row_limit/timeout_seconds,
# with hard maximums timeout <= 300s and row_limit <= 10000
# (app.adapters.demis.types). Execution eligibility validates server-side.
