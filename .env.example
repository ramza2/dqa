# DQA application
APP_ENV=development
APP_NAME=DEMIS Query Assistant
LOG_LEVEL=INFO

# Internal/LAN Docker binding
# Keep 127.0.0.1 for host-only development.
# Set DQA_LAN_BIND_IP to this development PC's LAN IPv4 for trusted-LAN testing.
DQA_LAN_BIND_IP=127.0.0.1
DQA_BACKEND_PORT=8000
DQA_DB_BIND_IP=127.0.0.1
DQA_DB_EXTERNAL_PORT=5432

# DQA PostgreSQL
DQA_DB_HOST=localhost
DQA_DB_PORT=5432
DQA_DB_NAME=dqa
DQA_DB_USER=dqa
DQA_DB_PASSWORD=change-me

# LLM provider (OpenAI-compatible abstraction)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# DEMIS read-only target (development fallback only)
# Production should use an operator-managed Connection Profile + approved secret source.
# Do not assume the real DEMIS DBMS until the integration requirement is confirmed.
# Do not commit real production values.
DEMIS_DB_TYPE=
DEMIS_DB_HOST=
DEMIS_DB_PORT=
DEMIS_DB_SERVICE=
DEMIS_DB_USER=
DEMIS_DB_PASSWORD=

# Runtime safety defaults
QUERY_DEFAULT_TIMEOUT_SECONDS=30
QUERY_MAX_TIMEOUT_SECONDS=120
QUERY_DEFAULT_ROW_LIMIT=200
QUERY_MAX_ROW_LIMIT=1000
