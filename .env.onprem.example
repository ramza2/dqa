# Placeholder example for internal / on-premise DQA deployment.
# Copy to `.env.onprem` (gitignored) and fill in site-specific values.
# Do not commit real secrets.

# ---------------------------------------------------------------------------
# Mode A — production / on-prem foundation (default for docker-compose.onprem.yml)
#   APP_ENV=production
#   DQA_AUTH_PROVIDER=disabled
#   Protected APIs fail closed (AUTH_PROVIDER_NOT_CONFIGURED) until an approved
#   production IdentityProvider exists.
#
# Mode B — development / LAN integration (use docker-compose.onprem.dev.yml overlay)
#   APP_ENV=development
#   DQA_AUTH_PROVIDER=dev_headers
#   Never enable Mode B on a production host.
# ---------------------------------------------------------------------------

APP_ENV=production
APP_NAME=DEMIS Query Assistant
LOG_LEVEL=INFO

# LAN-facing frontend bind (only published host port in production Compose)
DQA_LAN_BIND_IP=127.0.0.1
DQA_FRONTEND_PORT=8080

# DQA PostgreSQL (Compose-internal only; no host port in production Compose)
# DQA_DB_PASSWORD is REQUIRED — Compose fails if unset. Do not use "dqa"/"change-me".
DQA_DB_NAME=dqa
DQA_DB_USER=dqa
DQA_DB_PASSWORD=

# Authentication
# Production foundation must remain disabled / fail-closed.
# Never set DQA_AUTH_PROVIDER=dev_headers in production Compose.
DQA_AUTH_PROVIDER=disabled

# Do NOT set production actor/roles here.
# VITE_DQA_DEV_ACTOR / VITE_DQA_DEV_ROLES must never be injected into production builds.

# LLM provider (optional; core Catalog/Template APIs start without these)
# Leave blank when unused. Do not commit real endpoints, keys, or model names.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=10
# LLM_ENABLE_THINKING=false
# LLM_PARAMETER_EXTRACTION_ALLOW_RAW_REQUEST=false

# DEMIS Connection Profile credential env prefix (env: scheme only)
DQA_DEMIS_CREDENTIAL_ENV_PREFIX=DEMIS_SECRET_
# Example (do not commit real values):
# DEMIS_SECRET_ORACLE_PASSWORD=

# Runtime safety limits
QUERY_DEFAULT_TIMEOUT_SECONDS=30
QUERY_MAX_TIMEOUT_SECONDS=120
QUERY_DEFAULT_ROW_LIMIT=200
QUERY_MAX_ROW_LIMIT=1000

# Outstanding external blockers (not solved by this deployment foundation):
# 1. Approved production authentication / IdentityProvider
# 2. Confirmed DEMIS DBMS + concrete read-only driver requirements
