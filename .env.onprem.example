# Placeholder example for internal / on-premise DQA deployment.
# Copy to `.env.onprem` (gitignored) and fill in site-specific values.
# Do not commit real secrets.

# ---------------------------------------------------------------------------
# Auth is NOT configured via this file for production Compose.
#
# Mode A — production / on-prem (docker-compose.onprem.yml):
#   APP_ENV and DQA_AUTH_PROVIDER are HARDCODED in Compose as:
#     APP_ENV=production
#     DQA_AUTH_PROVIDER=disabled
#   Changing this env file cannot enable development auth.
#   Protected APIs fail closed until an approved production IdentityProvider exists.
#
# Mode B — development / LAN integration (explicit overlay only):
#   docker compose -f docker-compose.onprem.yml -f docker-compose.onprem.dev.yml ...
#   Overlay sets APP_ENV=development and DQA_AUTH_PROVIDER=dev_headers.
#   Never enable Mode B on a production host.
# ---------------------------------------------------------------------------

APP_NAME=DEMIS Query Assistant
LOG_LEVEL=INFO

# LAN-facing frontend bind (only published host port in production Compose)
DQA_LAN_BIND_IP=127.0.0.1
DQA_FRONTEND_PORT=8080

# DQA PostgreSQL (Compose-internal only; no host port in production Compose)
# DQA_DB_PASSWORD is REQUIRED — Compose fails if unset. Do not use "dqa"/"change-me".
DQA_DB_NAME=dqa
DQA_DB_USER=dqa
DQA_DB_PASSWORD=

# Do NOT set APP_ENV / DQA_AUTH_PROVIDER here for production.
# Production Compose ignores operator attempts to enable development auth via .env.
# Do NOT set production actor/roles here.
# VITE_DQA_DEV_ACTOR / VITE_DQA_DEV_ROLES must never be injected into production builds.

# LLM provider (optional; core Catalog/Template APIs start without these)
# Leave blank when unused. Do not commit real endpoints, keys, or model names.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=10
# LLM_ENABLE_THINKING=false
# LLM_PARAMETER_EXTRACTION_ALLOW_RAW_REQUEST=false

# DEMIS Connection Profile credential env prefix (env: scheme only)
DQA_DEMIS_CREDENTIAL_ENV_PREFIX=DEMIS_SECRET_
# Example (do not commit real values):
# DEMIS_SECRET_ORACLE_PASSWORD=

# Query execution limits are NOT configured via unused QUERY_* env vars.
# Authoritative behavior:
# - each approved Query Template defines row_limit and timeout_seconds
# - application hard maximums: timeout <= 300s, row_limit <= 10000
#   (app.adapters.demis.types.MAX_TIMEOUT_SECONDS / MAX_ROW_LIMIT)
# - execution eligibility validates these server-side
# Future site-wide tighter limits require an explicit policy feature.

# Outstanding external blockers (not solved by this deployment foundation):
# 1. Approved production authentication / IdentityProvider
# 2. Confirmed DEMIS DBMS + concrete read-only driver requirements
# 3. Approved TLS termination for real medical-data use
